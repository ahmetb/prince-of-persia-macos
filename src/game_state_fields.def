POP_BASE_FIELD(guardhp_curr, word, U16, guardhp_curr)
POP_BASE_FIELD(guardhp_max, word, U16, guardhp_max)
POP_BASE_FIELD(demo_index, word, U16, demo_index)
POP_BASE_FIELD(demo_time, short, I16, demo_time)
POP_BASE_FIELD(curr_guard_color, word, U16, curr_guard_color)

POP_BASE_FIELD(droppedout, word, U16, droppedout)
// collision
POP_BASE_FIELD(curr_row_coll_room, sbyte, S8A10, curr_row_coll_room[10])
POP_BASE_FIELD(curr_row_coll_flags, byte, U8A10, curr_row_coll_flags[10])
POP_BASE_FIELD(below_row_coll_room, sbyte, S8A10, below_row_coll_room[10])
POP_BASE_FIELD(below_row_coll_flags, byte, U8A10, below_row_coll_flags[10])
POP_BASE_FIELD(above_row_coll_room, sbyte, S8A10, above_row_coll_room[10])
POP_BASE_FIELD(above_row_coll_flags, byte, U8A10, above_row_coll_flags[10])

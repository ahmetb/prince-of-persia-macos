/*
Shared manifest of the engine's replay/quick-save base state fields.
Copyright (C) 2026  The Prince of Persia macOS port authors.

This list is the single source of truth for the ordered field stream used by
the legacy replay contract (quick_process) and the native .popsave codec.
Each entry: POP_BASE_FIELD(name, c_type, codec_kind, decl)
  name       - bare identifier, used by field accessors
  c_type     - base C type, used by the native codec
  codec_kind - native codec dispatch tag
  decl       - full member declaration (identifier plus array dimensions)

IMPORTANT: keep the exact order and conditional tails below in sync with the
pinned SDLPoP commit state layout. The legacy replay fixtures depend on it.
*/

// level
POP_BASE_FIELD(level, level_type, LEVEL, level)
POP_BASE_FIELD(checkpoint, word, U16, checkpoint)
POP_BASE_FIELD(upside_down, word, U16, upside_down)
POP_BASE_FIELD(drawn_room, word, U16, drawn_room)
POP_BASE_FIELD(current_level, word, U16, current_level)
POP_BASE_FIELD(next_level, word, U16, next_level)
POP_BASE_FIELD(mobs_count, short, I16, mobs_count)
POP_BASE_FIELD(mobs, mob_type, MOBS, mobs[14])
POP_BASE_FIELD(trobs_count, short, I16, trobs_count)
POP_BASE_FIELD(trobs, trob_type, TROBS, trobs[TROBS_MAX])
POP_BASE_FIELD(leveldoor_open, word, U16, leveldoor_open)
// kid
POP_BASE_FIELD(Kid, char_type, CHAR, Kid)

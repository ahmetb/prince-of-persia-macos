// saved controls
POP_BASE_FIELD(control_x, sbyte, I8, control_x)
POP_BASE_FIELD(control_y, sbyte, I8, control_y)
POP_BASE_FIELD(control_shift, sbyte, I8, control_shift)
POP_BASE_FIELD(control_forward, sbyte, I8, control_forward)
